# 复制为 .env 后填写；.env 已在 .gitignore 里，不会被提交
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef
# 代理，留空表示直连。示例：
# TG_PROXY=socks5://127.0.0.1:1080
# TG_PROXY=socks5://user:pass@127.0.0.1:1080
# TG_PROXY=http://127.0.0.1:8080
TG_PROXY=
# 状态目录（session/索引/进度/日志），默认 ./state
# TG_STATE_DIR=D:\\tg_archiver_state
# 端口
# TG_PORT_LOGIN=47050
# TG_PORT_MONITOR=47060
